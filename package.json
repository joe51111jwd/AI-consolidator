{
  "name": "switchboard",
  "version": "0.1.0",
  "description": "One whiteboard for your AI agents, chats, code projects and clients.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --config vite.config.mjs\" \"wait-on tcp:5173 && SB_DEV=1 electron .\"",
    "build": "vite build --config vite.config.mjs",
    "start": "vite build --config vite.config.mjs && electron .",
    "dist": "vite build --config vite.config.mjs && electron-builder --mac",
    "typecheck": "tsc --noEmit",
    "demo": "vite build --config vite.config.mjs && node scripts/demo.cjs",
    "test": "vite build && node tests/e2e.cjs"
  },
  "author": "joe51111jwd",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "productName": "Switchboard",
  "bin": {
    "sb": "electron/cli/sb.cjs"
  },
  "build": {
    "appId": "com.switchboard.desktop",
    "productName": "Switchboard",
    "asar": false,
    "files": [
      "electron/**",
      "dist-renderer/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
