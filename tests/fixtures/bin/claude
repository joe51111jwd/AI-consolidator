#!/usr/bin/env node
'use strict';
// Test stand-in for Claude Code. Behaves like `claude -p --output-format stream-json --verbose`:
// reads the prompt from stdin, prints stream-json events, and writes a session file the way the
// real CLI does, under $CLAUDE_CONFIG_DIR (or ~/.claude). Every call is logged to $SB_TEST_LOG.
// `claude auth status --json` reports the account stored by the fake login in tests.
const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');

const args = process.argv.slice(2);
const dir = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
const log = (o) => { if (process.env.SB_TEST_LOG) fs.appendFileSync(process.env.SB_TEST_LOG, JSON.stringify({ bin: 'claude', ...o }) + '\n'); };
const val = (f) => { const i = args.indexOf(f); return i >= 0 ? args[i + 1] : null; };

if (args[0] === 'auth' && args[1] === 'status') {
  const f = process.env.CLAUDE_CONFIG_DIR ? path.join(dir, '.claude.json') : path.join(os.homedir(), '.claude.json');
  let acct = null; try { acct = JSON.parse(fs.readFileSync(f, 'utf8')).oauthAccount || null; } catch {}
  log({ args, configDir: process.env.CLAUDE_CONFIG_DIR || null });
  process.stdout.write(JSON.stringify(acct ? { loggedIn: true, authMethod: 'claude.ai', email: acct.emailAddress, orgId: acct.organizationUuid || null, orgName: acct.organizationName, subscriptionType: acct.subscriptionType } : { loggedIn: false }) + '\n');
  process.exit(acct ? 0 : 1);
}
if (args[0] === 'auth' && (args[1] === 'login' || args[1] === 'logout')) {
  // Fake browser sign-in: $SB_TEST_LOGINS maps a config folder name to the account to sign in as.
  const f = process.env.CLAUDE_CONFIG_DIR ? path.join(dir, '.claude.json') : path.join(os.homedir(), '.claude.json');
  log({ args, configDir: process.env.CLAUDE_CONFIG_DIR || null });
  let cur = {}; try { cur = JSON.parse(fs.readFileSync(f, 'utf8')); } catch {}
  if (args[1] === 'logout') { delete cur.oauthAccount; fs.writeFileSync(f, JSON.stringify(cur)); console.log('Logged out'); process.exit(0); }
  let map = {}; try { map = JSON.parse(fs.readFileSync(process.env.SB_TEST_LOGINS, 'utf8')); } catch {}
  const who = map[path.basename(dir)] || { emailAddress: 'someone@example.com', organizationName: 'Personal', subscriptionType: 'pro' };
  console.log('Opening browser to sign in... https://claude.ai/oauth/authorize?code=true&client_id=test');
  // A ".slow-login" file in the folder keeps the sign-in waiting, like a browser left open.
  const wait = fs.existsSync(path.join(dir, '.slow-login')) ? 60000 : 400;
  setTimeout(() => { fs.mkdirSync(path.dirname(f), { recursive: true }); fs.writeFileSync(f, JSON.stringify({ ...cur, oauthAccount: who })); console.log('Login successful'); process.exit(0); }, wait);
  return;
}
if (args[0] === 'mcp') { log({ args, configDir: process.env.CLAUDE_CONFIG_DIR || null }); console.log('Added stdio MCP server switchboard'); process.exit(0); }

// A prompt with "[slow]" in it is slow mode: it streams a first message, then keeps working for
// $SB_STUB_SLOW_MS (default 30 s) before the reply, so tests can press Stop. Being stopped (SIGTERM)
// is logged as { event: 'stopped' } and ends it without the reply, like the real CLI.
let input = '';
process.stdin.on('data', (d) => { input += d; });
process.stdin.on('end', () => { answer().catch((e) => { process.stderr.write(`${e.stack || e.message}\n`); process.exit(1); }); });

// A prompt line `TOOL <Name> <json input>` makes the stand-in use that tool, as Claude would. With
// --permission-prompt-tool it first asks that tool (served by the MCP server --mcp-config names, the
// same way Claude Code does) and goes ahead only on {"behavior":"allow"}.
async function answer() {
  const resume = val('--resume');
  const id = resume || crypto.randomUUID();
  const cwd = process.cwd();
  const slow = /\[slow\]/.test(input);
  log({ args, cwd, configDir: process.env.CLAUDE_CONFIG_DIR || null, sessionId: id, model: val('--model'), slow, prompt: input });
  const tools = [];
  const said = input.split('\n').filter((l) => {
    const m = l.match(/^TOOL (\w+) (\{.*\})\s*$/);
    if (m) tools.push({ name: m[1], input: JSON.parse(m[2]) });
    return !m;
  });
  const first = said.join('\n').trim().split('\n').pop().slice(0, 120);
  const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
  const file = path.join(dir, 'projects', cwd.replace(/[/.]/g, '-'), `${id}.jsonl`);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  // Session rows are written in one go at the end, and before waiting on a permission answer so the
  // chat's card is there to answer on.
  const rows = [];
  const save = (r) => rows.push({ sessionId: id, cwd, timestamp: new Date().toISOString(), uuid: crypto.randomUUID(), ...r });
  const flush = () => { if (rows.length) fs.appendFileSync(file, rows.splice(0).map((r) => JSON.stringify(r)).join('\n') + '\n'); };
  out({ type: 'system', subtype: 'init', session_id: id, cwd, model: 'claude-sonnet-5-5' });
  save({ type: 'user', message: { role: 'user', content: input } });
  const outcomes = [];
  for (const t of tools) {
    const tid = 'toolu_' + crypto.randomBytes(6).toString('hex');
    const use = { id: 'msg_' + crypto.randomBytes(6).toString('hex'), role: 'assistant', model: 'claude-sonnet-5-5', content: [{ type: 'tool_use', id: tid, name: t.name, input: t.input }], usage: { input_tokens: 100, output_tokens: 20 } };
    out({ type: 'assistant', session_id: id, message: use });
    save({ type: 'assistant', message: use });
    const promptTool = val('--permission-prompt-tool');
    flush();
    const result = promptTool ? await askPermission(promptTool, { tool_name: t.name, input: t.input, tool_use_id: tid }) : { behavior: 'allow', updatedInput: t.input };
    log({ permission: { tool: t.name, input: t.input, result, asked: !!promptTool }, sessionId: id });
    const ok = result.behavior === 'allow';
    const res = { role: 'user', content: [{ type: 'tool_result', tool_use_id: tid, content: ok ? 'ok' : result.message, is_error: !ok }] };
    out({ type: 'user', session_id: id, message: res });
    save({ type: 'user', message: res });
    outcomes.push(ok ? `${t.name} allowed` : `${t.name} denied (${result.message})`);
  }
  if (slow) {
    // Slow mode: a first message, then the reply only after $SB_STUB_SLOW_MS, so Stop can be pressed.
    process.on('SIGTERM', () => { log({ event: 'stopped', sessionId: id }); flush(); process.exit(143); });
    const think = { id: 'msg_' + crypto.randomBytes(6).toString('hex'), role: 'assistant', model: 'claude-sonnet-5-5', content: [{ type: 'text', text: 'Thinking it through, one step at a time…' }], usage: { input_tokens: 100, output_tokens: 20 } };
    out({ type: 'assistant', session_id: id, message: think });
    save({ type: 'assistant', message: think });
    flush();
    await new Promise((r) => setTimeout(r, Number(process.env.SB_STUB_SLOW_MS) || 30000));
  }
  const reply = process.env.SB_STUB_REPLY || chatContext(input) || smartGroup(input) || topics(input) || projectMatch(input) || (slow ? `Slow reply finished: ${first}` : `Done (${path.basename(dir)}): ${first}`) + `${outcomes.length ? ` · ${outcomes.join(' · ')}` : ''}`;
  const mid = 'msg_' + crypto.randomBytes(6).toString('hex');
  out({ type: 'assistant', session_id: id, message: { id: mid, role: 'assistant', model: 'claude-sonnet-5-5', content: [{ type: 'text', text: reply }], usage: { input_tokens: 1200, output_tokens: 300 } } });
  out({ type: 'result', subtype: 'success', session_id: id, result: reply, usage: { input_tokens: 1200, output_tokens: 300 }, total_cost_usd: 0.01 });
  save({ type: 'assistant', message: { id: mid, role: 'assistant', model: 'claude-sonnet-5-5', content: [{ type: 'text', text: reply }], usage: { input_tokens: 1200, output_tokens: 300 } } });
  flush();
}

// Calls mcp__<server>__<tool> over stdio and returns the JSON it answers with.
async function askPermission(ref, request) {
  const m = ref.match(/^mcp__(.+?)__(.+)$/);
  if (!m) throw new Error(`not an MCP tool: ${ref}`);
  const conf = val('--mcp-config');
  const servers = JSON.parse(conf.trim().startsWith('{') ? conf : fs.readFileSync(conf, 'utf8')).mcpServers || {};
  const srv = servers[m[1]];
  if (!srv) throw new Error(`--mcp-config has no "${m[1]}" server`);
  const { Client } = require('@modelcontextprotocol/sdk/client/index.js');
  const { StdioClientTransport } = require('@modelcontextprotocol/sdk/client/stdio.js');
  const client = new Client({ name: 'claude-stand-in', version: '1.0.0' });
  await client.connect(new StdioClientTransport({ command: srv.command, args: srv.args || [], env: { ...process.env, ...(srv.env || {}) }, stderr: 'inherit' }));
  try {
    const r = await client.callTool({ name: m[2], arguments: request }, undefined, { timeout: 11 * 60000 });
    return JSON.parse(r.content[0].text);
  } finally { await client.close().catch(() => {}); }
}

// The real item lines ("12. [kind] Title | folder: x | client: y | ..."), not the indented examples.
function itemRows(text) {
  const rows = [];
  for (const line of text.split('\n')) {
    const m = line.match(/^(\d+)\. \[([^\]]+)\] (.*)$/); if (!m) continue;
    const [title, ...fields] = m[3].split(' | ');
    const f = {};
    for (const x of fields) { const i = x.indexOf(': '); if (i > 0) f[x.slice(0, i)] = x.slice(i + 2).trim(); }
    rows.push({ n: Number(m[1]), kind: m[2], title, client: f.client || null, folder: f.folder || null, line });
  }
  return rows;
}

// Chat context (electron/ext/context.cjs) asks for a JSON array, one summary per "### Chat n" block.
// Each summary is made from the block: "Gist: <first ask>", the client named after "for" in the first
// ask (else null), the folder as the project, and "Next: check <title>".
function chatContext(text) {
  if (!text.startsWith('Summarize each of these AI chats for my dashboard')) return null;
  const out = [];
  for (const block of text.split(/^### Chat /m).slice(1)) {
    const n = Number(block.match(/^(\d+)/)[1]);
    const field = (k) => ((block.match(new RegExp(`^${k}: (.*)$`, 'm')) || [])[1] || '').trim();
    const title = field('Title') || 'Untitled';
    const ask = field('First ask') || title;
    const folder = field('Folder').replace(/ \(branch .*\)$/, '');
    const client = ((ask.match(/\bfor ((?:[A-Z][\w&'-]*\s?){1,3})/) || [])[1] || '').trim() || null;
    out.push({
      n, about: `Gist: ${ask.split(/[.!?:]/)[0].slice(0, 70)}`, client, project: folder || null,
      status: /Right now: working/.test(block) ? 'working' : 'done', nextStep: `Next: check ${title.slice(0, 40)}`, people: client ? [client] : [],
    });
  }
  return '```json\n' + JSON.stringify(out) + '\n```';
}

// Smart group asks for JSON: group the numbered cards by the client each one mentions.
function smartGroup(text) {
  if (!/Group these cards from my work whiteboard/.test(text)) return null;
  const groups = new Map();
  for (const r of itemRows(text)) {
    const label = r.client || 'Everything else';
    groups.set(label, [...(groups.get(label) || []), r.n]);
  }
  return JSON.stringify({ groups: [...groups].map(([label, items]) => ({ label, items })) });
}

// The home asks for a client / project tree as JSON: one per client, else per project folder. Meetings and
// emails with no client join a folder topic named in their title.
// With the owner's own groups, each item goes to the first group whose name it mentions, else Other.
function topics(text) {
  if (!/Sort them into 2 to 8 topics/.test(text)) return null;
  if (/Use EXACTLY these top-level groups/.test(text)) return ownGroups(text);
  const rows = itemRows(text).map((r) => ({ n: r.n, title: r.title.toLowerCase(), client: !!r.client, label: r.client || r.folder }));
  const folders = [...new Set(rows.map((r) => r.label).filter(Boolean))];
  const groups = new Map();
  for (const r of rows) {
    const label = r.label || folders.find((f) => r.title.includes(f.toLowerCase())) || 'Everything else';
    groups.set(label, [...(groups.get(label) || []), r.n]);
  }
  const clients = new Set(rows.filter((r) => r.client).map((r) => r.label));
  return JSON.stringify({ clients: [...groups].map(([label, items]) => ({ label, client: clients.has(label), projects: [{ label, summary: `${items.length} items`, items }] })) });
}

function ownGroups(text) {
  const labels = [...text.matchAll(/^ {2}"([^"]+)"/gm)].map((m) => m[1]);
  const groups = new Map(labels.map((l) => [l, []]));
  groups.set('Other', []);
  for (const r of itemRows(text)) {
    const hit = labels.find((l) => r.line.toLowerCase().includes(l.toLowerCase())) || 'Other';
    groups.get(hit).push(r.n);
  }
  return JSON.stringify({ clients: [...groups].filter(([, items]) => items.length).map(([label, items]) => ({ label, client: label !== 'Other', projects: [{ label, summary: `${items.length} items`, items }] })) });
}

// Imported claude.ai chats are matched to their Claude Projects: a chat goes to the Project whose name
// starts with a word the chat's line mentions ("Harbor Coffee Launch" for a chat about Harbor Coffee).
function projectMatch(text) {
  if (!/Which of my Claude Projects does each chat belong to/.test(text)) return null;
  const projects = [...text.matchAll(/^P(\d+)\. ([^|\n]+)/gm)].map((m) => ({ id: `P${m[1]}`, word: m[2].trim().split(/\s+/)[0].toLowerCase() }));
  const chats = [];
  for (const line of (text.split('\nChats:\n')[1] || '').split('\n')) {
    const m = line.match(/^(\d+)\. (.*)$/); if (!m) continue;
    const p = projects.find((x) => x.word.length >= 4 && m[2].toLowerCase().includes(x.word));
    chats.push({ chat: Number(m[1]), project: p ? p.id : null });
  }
  return JSON.stringify({ chats });
}
